{
  "name": "waivern-govern",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "bootstrap": "./scripts/bootstrap.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:fix": "eslint --fix --max-warnings 0 --cache --cache-location node_modules/.cache/.eslintcache",
    "format": "prettier --check \"**/*.{js,cjs,mjs,jsx,ts,tsx,mdx}\" --cache --cache-location node_modules/.cache/.prettiercache",
    "format:fix": "prettier --write \"**/*.{js,cjs,mjs,jsx,ts,tsx,mdx}\" --cache --cache-location node_modules/.cache/.prettiercache",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "audit:verify": "tsx --env-file-if-exists=.env.local scripts/verify-audit.ts",
    "db:reset": "docker exec govern-db psql -U govern -d govern -q -c 'drop schema if exists public cascade; drop schema if exists drizzle cascade; create schema public;' && pnpm db:migrate",
    "test": "DATABASE_URL=postgresql://govern:govern@localhost:55432/govern_test tsx --env-file-if-exists=.env.local --test tests/**/*.test.ts",
    "test:db": "docker exec govern-db psql -U govern -d postgres -tc \"select 1 from pg_database where datname='govern_test'\" | grep -q 1 || docker exec govern-db createdb -U govern govern_test",
    "pretest": "pnpm test:db && DATABASE_URL=postgresql://govern:govern@localhost:55432/govern_test pnpm db:migrate",
    "test:reset": "docker exec govern-db dropdb -U govern --if-exists govern_test && pnpm test:db",
    "dev:webpack": "next dev --webpack",
    "seed:demo": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "provision": "tsx --env-file-if-exists=.env.local scripts/provision-connections.ts",
    "grant": "tsx --env-file-if-exists=.env.local scripts/grant-access.ts",
    "sweep": "tsx --env-file-if-exists=.env.local scripts/sweep.ts",
    "sweep:prod": "tsx scripts/sweep.ts",
    "seed:countries": "tsx --env-file-if-exists=.env.local scripts/seed-countries.ts",
    "db:migrate:deploy": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "help:md": "tsx --env-file-if-exists=.env.local scripts/help-to-markdown.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "^9.3.14",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "24.x"
  }
}
