# Local dev points at docker-compose. In production this is the Neon pooled
# connection string for a database in eu-west-2.
DATABASE_URL="postgresql://govern:govern@localhost:55432/govern"

# Auth.js reads AUTH_SECRET itself; it signs the session cookie.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# The deployment's own origin. In production this must be the real URL, or
# the OIDC redirect will come back to the wrong place.
AUTH_URL="http://localhost:3000"

# OIDC providers. Either may be omitted; at least one is needed to sign in.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Local and demo only. Signs in as any seeded user with no password.
# The build throws if this is ever set alongside NODE_ENV=production.
ALLOW_DEV_SIGN_IN="true"

# Bearer token a scheduler presents to /api/cron/sweep. Unset, every call is refused.
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# Encrypts integration shared secrets at rest, so a database dump alone
# yields no working credentials. Generate with: openssl rand -base64 32
INTEGRATION_KEY=""

# "true" only on Waivern's own hosted service. Shows the hosting, backup and
# dedicated-instance sections of /security, which describe Waivern's promises
# and would be untrue on anybody else's copy.
# WAIVERN_HOSTED=true

# Transactional email through Resend. EMAIL_FROM must be at a domain verified
# in Resend. Two kinds, each behind its own switch:
#  - to the PLATFORM_ADMINS, on a new organisation request or new feedback:
#    only when WAIVERN_HOSTED is "true";
#  - alert and action emails to an organisation's own people (new tasks,
#    overdue work, mentions, decisions on their assessments): only when
#    NOTIFICATION_EMAILS is "true", never when WAIVERN_HOSTED is, and only to
#    people who have turned them on in their profile. Sent by the sweep.
# RESEND_API_KEY=""
# EMAIL_FROM="Waivern Governance <info@waivern.com>"
# NOTIFICATION_EMAILS=true

# Virus scanning of uploaded files, by a ClamAV daemon (clamd) you run on the
# deployment's private network — files are never sent outside it. Off unless
# CLAMAV_HOST is set, and /security then says files are not scanned. Once set,
# it is relied on: if clamd cannot be reached, uploads are refused with "try
# again shortly" rather than stored unchecked. Set it on the sweep service too,
# which scans files stored before scanning was switched on. See
# docs/deploying.md → "Virus scanning".
# CLAMAV_HOST="clamav.railway.internal"
# CLAMAV_PORT="3310"

# Put excerpts of what the model said into the logs. Off unless "true".
#
# Only useful for chasing "the model answered, but not in a shape that could be
# read", where the answer itself is the evidence. A model's reply quotes the
# document it read, so this puts extracts of somebody's contract into the log
# stream — switch it on for a debugging session on a system you control, then
# off again. Everything else logged about a request is shapes only: sizes,
# durations, stop reasons, counts.
# ASSISTANT_DEBUG_BODIES=true

# Local development only: lets the cookies page use a Consent Analyser running
# on this machine (http://127.0.0.1:8080), which is otherwise refused as a
# private address. Ignored in production.
# CONSENT_ANALYSER_ALLOW_LOCAL="true"
