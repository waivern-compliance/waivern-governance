# Local dev points at docker-compose. In production this is the Neon pooled
# connection string for a database in eu-west-2.
DATABASE_URL="postgresql://govern:govern@localhost:55432/govern"

# Auth.js reads AUTH_SECRET itself; it signs the session cookie.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# The deployment's own origin. Auth.js sends every sign-in back to this host,
# so set it only when the deployment has one address.
AUTH_URL="http://localhost:3000"
# Reached at more than one address (a Railway domain and your own, say)? Leave
# AUTH_URL unset and list them instead: APP_URL is the main one, used for links
# in emails; APP_ALIAS_URLS (comma-separated) are the others. Register each
# address's callback with the identity provider.
# APP_URL="https://govern.example.org"
# APP_ALIAS_URLS="https://govern-production.up.railway.app"

# OIDC providers. Either may be omitted; at least one is needed to sign in.
#
# Microsoft Entra ID: the issuer decides who may sign in.
# - Single-tenant (self-hosted): https://login.microsoftonline.com/<your tenant id>/v2.0
#   Only your own directory signs in, and people are matched to invitations by
#   email address, which your directory's administrators are trusted to set.
# - Multi-tenant (Waivern's hosted service): https://login.microsoftonline.com/organizations/v2.0
#   Any work Microsoft account signs in. Each person is bound to their Microsoft
#   account on first sign-in and matched by tenant and object id after that.
#   A first sign-in is matched to an invitation only if the token's xms_edov
#   optional claim is true or the organisation trusts the tenant; register the
#   email and xms_edov optional claims. See docs/deploying-railway.md, step 4.
# Unset means the provider's default, common, which is multi-tenant. Personal
# Microsoft accounts are refused either way.
# The client id is also published at /.well-known/microsoft-identity-association.json,
# which Entra fetches to verify the app's publisher domain; unset, that path is not found.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Local and demo only. Signs in as any seeded user with no password.
# The build throws if this is ever set alongside NODE_ENV=production.
ALLOW_DEV_SIGN_IN="true"

# Bearer token a scheduler presents to /api/cron/sweep. Unset, every call is refused.
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# Encrypts integration shared secrets at rest, so a database dump alone
# yields no working credentials. Generate with: openssl rand -base64 32
INTEGRATION_KEY=""

# "true" only on Waivern's own hosted service. Shows the hosting, backup and
# dedicated-instance sections of /security, which describe Waivern's promises
# and would be untrue on anybody else's copy.
# WAIVERN_HOSTED=true

# A Cookiebot cookie consent banner: the domain group ID from the Cookiebot
# Manager. Off unless set. Loads the banner first on every page except public
# request forms, adds a "Cookie settings" link and the cookie declaration to
# the footer, and lets the Content-Security-Policy reach Cookiebot. Add each
# deployment's domain to the domain group, or Cookiebot will not show it.
# COOKIEBOT_ID=""

# Transactional email through Resend. EMAIL_FROM must be at a domain verified
# in Resend. Two kinds, each behind its own switch:
#  - to the PLATFORM_ADMINS, on a new organisation request or new feedback:
#    only when WAIVERN_HOSTED is "true";
#  - alert and action emails to an organisation's own people (new tasks,
#    overdue work, mentions, decisions on their assessments): only when
#    NOTIFICATION_EMAILS is "true", never when WAIVERN_HOSTED is, and only to
#    people who have turned them on in their profile. Sent by the sweep.
# RESEND_API_KEY=""
# EMAIL_FROM="Waivern Governance <info@waivern.com>"
# NOTIFICATION_EMAILS=true

# Self-service 7-day trials (TRIAL_DAYS in src/lib/trial-rules.ts) at /trial: anybody may give an email address,
# personal ones included, and is sent a single-use link that starts a trial
# organisation of their own. A trial is text only and reaches nobody else.
# Off unless "true". Also needs PLATFORM_ADMINS, who decide requests to extend
# or convert a trial, and in production RESEND_API_KEY and EMAIL_FROM to send
# the link (it goes to whoever asked, whatever WAIVERN_HOSTED says). In
# development without them the link is written to the server log instead.
# TRIAL_SIGN_UP=true
# Where a trial can book a guided demo or an advisory session with Waivern,
# offered as the trial nears its end and on the page shown once it has ended.
# Must be an https address. Unset, no booking link is shown.
# TRIAL_BOOKING_URL="https://example.com/book-a-demo"

# Virus scanning of uploaded files, by a ClamAV daemon (clamd) you run on the
# deployment's private network — files are never sent outside it. Off unless
# CLAMAV_HOST is set, and /security then says files are not scanned. Once set,
# it is relied on: if clamd cannot be reached, uploads are refused with "try
# again shortly" rather than stored unchecked. Set it on the sweep service too,
# which scans files stored before scanning was switched on. See
# docs/deploying.md → "Virus scanning".
# CLAMAV_HOST="clamav.railway.internal"
# CLAMAV_PORT="3310"

# Put excerpts of what the model said into the logs. Off unless "true".
#
# Only useful for chasing "the model answered, but not in a shape that could be
# read", where the answer itself is the evidence. A model's reply quotes the
# document it read, so this puts extracts of somebody's contract into the log
# stream — switch it on for a debugging session on a system you control, then
# off again. Everything else logged about a request is shapes only: sizes,
# durations, stop reasons, counts.
# ASSISTANT_DEBUG_BODIES=true

# Local development only: lets the cookies page use a Consent Analyser running
# on this machine (http://127.0.0.1:8080), which is otherwise refused as a
# private address. Ignored in production.
# CONSENT_ANALYSER_ALLOW_LOCAL="true"

# The largest organisation, in bytes, that an owner may export all at once from
# the Exports page. Above it the page says to ask Waivern, who run
# `pnpm export:organisation`, which has no limit. Unset: 2147483648 (2 GB).
# EXPORT_MAX_BYTES=2147483648
