# Git feeds one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
zero_sha=0000000000000000000000000000000000000000

while read -r _local_ref local_sha remote_ref _remote_sha; do
  # Deleting a remote branch is always allowed.
  [ "$local_sha" = "$zero_sha" ] && continue

  case "$remote_ref" in
    refs/heads/*) branch="${remote_ref#refs/heads/}" ;;
    *) continue ;;
  esac

  if [ "$branch" = "main" ]; then
    echo "✗ Pushing to main is not allowed. Open a pull request from a branch instead." >&2
    exit 1
  fi

  ./scripts/check-branch-name.sh "$branch" || exit 1
done
